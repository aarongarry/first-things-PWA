# Copy to .env (never committed) and fill in. See README → Google Calendar.
# Upload to Supabase with:  npx supabase secrets set --env-file .env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI in Google Cloud Console exactly.
GOOGLE_REDIRECT_URI=https://fvvekwiatzivjyvppwmp.supabase.co/functions/v1/google-calendar
# Pages allowed to start a connection and receive the user afterwards.
APP_ORIGINS=https://aarongarry.github.io,http://localhost:4173
# Encrypts stored Google refresh tokens. Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
